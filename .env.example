# Copy to .env.local and fill in. Never commit real values.

# Public origin of the site, no trailing slash. Used by sitemap.xml and robots.txt
# (and should feed metadataBase in src/app/layout.tsx).
NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (src/app/api/contact/route.ts) ---------------------
# Option A: email through Resend. Both RESEND_API_KEY and CONTACT_TO_EMAIL are required.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "One Spot <hello@yourdomain.com>".
# Defaults to "One Spot <onboarding@resend.dev>", which only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=

# Option B: POST the enquiry as JSON to a webhook. Used when Resend is not configured,
# or as a second attempt when the Resend call fails.
CONTACT_WEBHOOK_URL=

# With neither option set: development logs the enquiry to the server console and returns ok;
# production returns 503 so the form shows its error state instead of dropping the message.

# Optional. Shown as a mailto link next to the form's error message.
NEXT_PUBLIC_CONTACT_EMAIL=
